#!/bin/bash

app=${1:-}
if [[ -z $app ]]; then
  echo "Usage: omarchy-focus-app <app-name>" >&2
  exit 1
fi

if [[ -n ${NIRI_SOCKET:-} ]]; then
  window_id=$(
    niri msg --json windows 2>/dev/null |
      jq -r --arg pattern "$app" \
        'def matches($value): ($value // "") | test($pattern; "i");
         first(.[] | select(matches(.app_id) or matches(.title))).id // empty'
  )
  [[ -n $window_id ]] || exit 1
  exec niri msg action focus-window --id "$window_id"
fi

exec "$OMARCHY_PATH/bin/omarchy-hyprland-focus-app" "$app"
